<%- include('../partials/header') %>

<div class="app-layout">

  <%- include('../partials/navbar', { paginaAtiva: 'reservas' }) %>

  <main class="main-content">

    <header class="topbar">
      <h1><%= titulo || 'Reservas' %></h1>

      <div class="topbar-actions">
        <input type="text" placeholder="Pesquisar..." disabled>

        <span class="notification-icon">
          <i class="bi bi-bell-fill"></i>
        </span>

        <div class="user-info">
          <div class="user-avatar">
            <%= usuario && usuario.nome ? usuario.nome.charAt(0).toUpperCase() : 'A' %>
          </div>
          <span><%= usuario && usuario.nome ? usuario.nome : 'Admin' %></span>
        </div>
      </div>
    </header>

    <section class="content-area">
      <h2>Reservas de Áreas Comuns</h2>

      <%# Alerta de erro amigável — aparece no topo se houver erro %>
      <% if (erro) { %>
        <div class="alert alert-danger alert-dismissible fade show mx-1 mt-3" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <%= erro %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="table-card">

        <div class="table-toolbar">
          <div class="search-group">
            <i class="bi bi-search"></i>
            <input
              type="text"
              id="searchInput"
              placeholder="Buscar morador ou área..."
              oninput="filtrar()"
            >
          </div>

          <div class="filter-tabs">
            <button class="tab-btn active" onclick="setTab(this, 'todos')">Todos</button>
            <button class="tab-btn" onclick="setTab(this, 'Pendente')">Pendente</button>
            <button class="tab-btn" onclick="setTab(this, 'Aprovada')">Aprovada</button>
            <button class="tab-btn" onclick="setTab(this, 'Cancelada')">Cancelada</button>
            <button class="tab-btn" onclick="setTab(this, 'Concluída')">Concluída</button>
          </div>

          <button
            type="button"
            class="primary-button border-0"
            data-bs-toggle="modal"
            data-bs-target="#modalCadastrarReserva"
          >
            <i class="bi bi-plus-lg"></i>
            Nova Reserva
          </button>
        </div>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Área Comum</th>
                <th>Morador</th>
                <th>Data</th>
                <th>Horário</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>

            <tbody id="tabela">
              <% if (!reservas || reservas.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty-message">
                    Nenhuma reserva cadastrada.
                  </td>
                </tr>
              <% } else { %>
                <% reservas.forEach(reserva => { %>
                  <tr
                    data-area="<%= reserva.area.toLowerCase() %>"
                    data-morador="<%= reserva.morador.toLowerCase() %>"
                    data-status="<%= reserva.status %>"
                  >
                    <td><%= reserva.area %></td>
                    <td><%= reserva.morador %></td>
                    <td><%= reserva.data %></td>
                    <td><%= reserva.horario %></td>

                    <td>
                      <% if (reserva.status === 'Pendente') { %>
                        <span class="badge badge-pending">Pendente</span>
                      <% } else if (reserva.status === 'Aprovada') { %>
                        <span class="badge badge-active">Aprovada</span>
                      <% } else if (reserva.status === 'Cancelada') { %>
                        <span class="badge badge-inactive">Cancelada</span>
                      <% } else if (reserva.status === 'Concluída') { %>
                        <span class="badge badge-done">Concluída</span>
                      <% } %>
                    </td>

                    <td>
                      <button
                        type="button"
                        class="edit-link border-0 bg-transparent p-0"
                        data-bs-toggle="modal"
                        data-bs-target="#modalEditarReserva"
                        data-id="<%= reserva.id %>"
                        data-area="<%= reserva.area %>"
                        data-morador="<%= reserva.morador %>"
                        data-data="<%= reserva.data %>"
                        data-horario="<%= reserva.horario %>"
                        data-status="<%= reserva.status %>"
                      >
                        <i class="bi bi-pencil-fill"></i>
                        Editar
                      </button>

                      <form
                        action="/reservas/<%= reserva.id %>/excluir"
                        method="POST"
                        style="display: inline;"
                      >
                        <button
                          type="submit"
                          class="edit-link border-0 bg-transparent p-0 ms-2 text-danger"
                          onclick="return confirm('Deseja realmente excluir esta reserva?')"
                        >
                          <i class="bi bi-trash-fill"></i>
                          Excluir
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="table-footer">
          <span>
            Exibindo <span id="contador"><%= reservas ? reservas.length : 0 %></span> reservas
          </span>

          <div class="pagination">
            <button disabled>&laquo;</button>
            <button class="active-page">1</button>
            <button disabled>&raquo;</button>
          </div>
        </div>

      </div>
    </section>

  </main>

</div>

<!-- MODAL DE CADASTRO -->
<div class="modal fade" id="modalCadastrarReserva" tabindex="-1" aria-labelledby="modalCadastrarReservaLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">

      <div class="modal-header border-bottom-0 pb-0 mt-3 ms-3">
        <h4 class="modal-title fw-bold" id="modalCadastrarReservaLabel">Nova Reserva</h4>
        <button type="button" class="btn-close me-3" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body p-4">
        <form action="/reservas/salvar" method="POST">

          <h6 class="fw-bold mb-3">
            <i class="bi bi-calendar-event-fill text-primary me-2"></i>
            Dados da Reserva
          </h6>

          <div class="row g-3 mb-4">

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Área Comum <span class="text-danger">*</span>
              </label>
              <select name="area" class="form-control bg-light border-0" required>
                <option value="">Selecione...</option>
                <% ['Salão de Festas','Churrasqueira','Piscina','Quadra','Sala de Jogos'].forEach(a => { %>
                  <option value="<%= a %>" <%= dadosFormulario && dadosFormulario.area === a ? 'selected' : '' %>><%= a %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Morador <span class="text-danger">*</span>
              </label>
              <%# Select populado com moradores do banco %>
              <select name="morador" class="form-control bg-light border-0" required>
                <option value="">Selecione o morador...</option>
                <% if (moradores && moradores.length > 0) { %>
                  <% moradores.forEach(m => { %>
                    <option value="<%= m.nome %>" <%= dadosFormulario && dadosFormulario.morador === m.nome ? 'selected' : '' %>>
                      <%= m.nome %>
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Data <span class="text-danger">*</span>
              </label>
              <input
                type="date"
                name="data"
                class="form-control bg-light border-0"
                value="<%= dadosFormulario ? dadosFormulario.data : '' %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Horário <span class="text-danger">*</span>
              </label>
              <%# Máscara aplicada via JS — formata automaticamente HH:MM–HH:MM %>
              <input
                type="text"
                name="horario"
                id="horarioCadastro"
                class="form-control bg-light border-0"
                placeholder="Ex: 18:00–23:00"
                value="<%= dadosFormulario ? dadosFormulario.horario : '' %>"
                maxlength="11"
                required
              >
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Status <span class="text-danger">*</span>
              </label>
              <select name="status" class="form-control bg-light border-0" required>
                <% ['Pendente','Aprovada','Cancelada','Concluída'].forEach(s => { %>
                  <option value="<%= s %>" <%= dadosFormulario && dadosFormulario.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>

          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3" data-bs-dismiss="modal">
              Cancelar
            </button>
            <div class="d-flex align-items-center gap-3">
              <span class="text-muted small">* Campos obrigatórios</span>
              <button type="submit" class="btn text-white px-4 py-2 rounded-3" style="background-color: #172033; font-weight: 500;">
                Salvar Reserva
              </button>
            </div>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

<!-- MODAL DE EDIÇÃO -->
<div class="modal fade" id="modalEditarReserva" tabindex="-1" aria-labelledby="modalEditarReservaLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">

      <div class="modal-header border-bottom-0 pb-0 mt-3 ms-3">
        <h4 class="modal-title fw-bold" id="modalEditarReservaLabel">Editar Reserva</h4>
        <button type="button" class="btn-close me-3" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body p-4">
        <form id="formEditarReserva" action="#" method="POST">

          <h6 class="fw-bold mb-3">
            <i class="bi bi-calendar-event-fill text-primary me-2"></i>
            Dados da Reserva
          </h6>

          <div class="row g-3 mb-4">

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Área Comum <span class="text-danger">*</span>
              </label>
              <select id="editArea" name="area" class="form-control bg-light border-0" required>
                <% ['Salão de Festas','Churrasqueira','Piscina','Quadra','Sala de Jogos'].forEach(a => { %>
                  <option value="<%= a %>"><%= a %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Morador <span class="text-danger">*</span>
              </label>
              <%# Select populado com moradores do banco %>
              <select id="editMorador" name="morador" class="form-control bg-light border-0" required>
                <option value="">Selecione o morador...</option>
                <% if (moradores && moradores.length > 0) { %>
                  <% moradores.forEach(m => { %>
                    <option value="<%= m.nome %>"><%= m.nome %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Data <span class="text-danger">*</span>
              </label>
              <input type="date" id="editData" name="data" class="form-control bg-light border-0" required>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Horário <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                id="editHorario"
                name="horario"
                class="form-control bg-light border-0"
                placeholder="Ex: 18:00–23:00"
                maxlength="11"
                required
              >
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold text-muted">
                Status <span class="text-danger">*</span>
              </label>
              <select id="editStatus" name="status" class="form-control bg-light border-0" required>
                <% ['Pendente','Aprovada','Cancelada','Concluída'].forEach(s => { %>
                  <option value="<%= s %>"><%= s %></option>
                <% }) %>
              </select>
            </div>

          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3" data-bs-dismiss="modal">
              Cancelar
            </button>
            <button type="submit" class="btn text-white px-4 py-2 rounded-3" style="background-color: #172033; font-weight: 500;">
              Salvar Alterações
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

<style>
  .filter-tabs { display: flex; gap: 6px; }

  .tab-btn {
    padding: 6px 14px;
    border-radius: 7px;
    font-size: 13px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tab-btn.active { background: #172033; color: #fff; border-color: #172033; }
  .tab-btn:hover:not(.active) { background: #f1f5f9; }

  .badge-pending { background: #fef9c3; color: #854d0e; }
  .badge-done    { background: #dbeafe; color: #1e40af; }
</style>

<script>
  let filtroStatus = 'todos';

  function setTab(el, status) {
    document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    filtroStatus = status;
    filtrar();
  }

  function filtrar() {
    const busca = document.getElementById('searchInput').value.toLowerCase();
    const linhas = document.querySelectorAll('#tabela tr');
    let visiveis = 0;

    linhas.forEach(tr => {
      const area    = tr.dataset.area    || '';
      const morador = tr.dataset.morador || '';
      const status  = tr.dataset.status  || '';

      const matchStatus = filtroStatus === 'todos' || status === filtroStatus;
      const matchBusca  = area.includes(busca) || morador.includes(busca);

      if (matchStatus && matchBusca) {
        tr.style.display = '';
        visiveis++;
      } else {
        tr.style.display = 'none';
      }
    });

    document.getElementById('contador').textContent = visiveis;
  }

  // Máscara de horário — formata automaticamente HH:MM–HH:MM e barra letras
  function aplicarMascaraHorario(input) {
    input.addEventListener('keypress', function (e) {
      // Barra qualquer tecla que não seja número
      if (!/\d/.test(e.key)) e.preventDefault();
    });

    input.addEventListener('input', function () {
      let v = this.value.replace(/[^\d]/g, '');
      if (v.length >= 3) v = v.slice(0, 2) + ':' + v.slice(2);
      if (v.length >= 6) v = v.slice(0, 5) + '–' + v.slice(5);
      if (v.length >= 9) v = v.slice(0, 8) + ':' + v.slice(8);
      if (v.length > 11) v = v.slice(0, 11);
      this.value = v;
    });
  }

  aplicarMascaraHorario(document.getElementById('horarioCadastro'));
  aplicarMascaraHorario(document.getElementById('editHorario'));

  // Preenche o modal de edição com os dados da reserva clicada
  const modalEditar = document.getElementById('modalEditarReserva');
  if (modalEditar) {
    modalEditar.addEventListener('show.bs.modal', function (event) {
      const botao = event.relatedTarget;

      const id      = botao.getAttribute('data-id');
      const area    = botao.getAttribute('data-area');
      const morador = botao.getAttribute('data-morador');
      const data    = botao.getAttribute('data-data');
      const horario = botao.getAttribute('data-horario');
      const status  = botao.getAttribute('data-status');

      document.getElementById('formEditarReserva').action = `/reservas/${id}/editar`;

      document.getElementById('editArea').value    = area;
      document.getElementById('editMorador').value = morador;
      document.getElementById('editData').value    = data;
      document.getElementById('editHorario').value = horario;
      document.getElementById('editStatus').value  = status;
    });
  }

  // Abre o modal correto automaticamente se o servidor retornou erro
  <% if (typeof abrirModal !== 'undefined' && abrirModal) { %>
    document.addEventListener('DOMContentLoaded', function () {
      const modalId = '<%= abrirModal %>' === 'cadastro'
        ? 'modalCadastrarReserva'
        : 'modalEditarReserva';
      new bootstrap.Modal(document.getElementById(modalId)).show();
    });
  <% } %>
</script>

<%- include('../partials/footer') %>