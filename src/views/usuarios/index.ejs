<%- include('../partials/header') %>

<div class="app-layout">

  <%- include('../partials/navbar', { paginaAtiva: 'perfil' }) %>

  <main class="main-content">

    <header class="topbar">
      <h1><%= titulo || 'Perfil do Usuário' %></h1>

      <div class="topbar-actions">
        <input type="text" placeholder="Pesquisar..." disabled>

        <span class="notification-icon">
          <i class="bi bi-bell-fill"></i>
        </span>

        <div class="user-info">
          <div class="user-avatar">
            <%= usuario && usuario.iniciais ? usuario.iniciais.charAt(0) : 'A' %>
          </div>
          <span><%= usuario && usuario.nome ? usuario.nome : 'Admin' %></span>
        </div>
      </div>
    </header>

    <section class="content-area">

      <h2>Meu Perfil</h2>

      <div class="perfil-container">

        <div class="perfil-card">
          <div class="perfil-capa">
            <div class="perfil-avatar-grande">
              <%= usuario.iniciais || 'AD' %>
            </div>
          </div>

          <div class="perfil-corpo">
            <h3><%= usuario.nome %></h3>

            <span class="perfil-tipo">
              <i class="bi bi-shield-fill-check"></i>
              <%= usuario.tipo %>
            </span>

            <div class="perfil-dados">

              <div class="perfil-linha">
                <span>E-mail</span>
                <strong><%= usuario.email %></strong>
              </div>

              <div class="perfil-linha">
                <span>Telefone</span>
                <strong><%= usuario.telefone %></strong>
              </div>

              <div class="perfil-linha">
                <span>Cadastrado em</span>
                <strong><%= usuario.cadastradoEm %></strong>
              </div>

            </div>

            <a href="/logout" class="botao-sair">
              <i class="bi bi-box-arrow-right"></i>
              Sair da Conta
            </a>
          </div>
        </div>

        <div class="permissoes-card">
          <h3>
            <i class="bi bi-lock-fill"></i>
            Controle de Permissões
          </h3>

          <div class="permissao-bloco permissao-admin">
            <div class="permissao-topo">
              <span class="permissao-cargo">Administrador</span>
              <span>Acesso total ao sistema</span>
            </div>

            <div class="permissoes-grid">
              <p><span class="bolinha verde"></span> Moradores</p>
              <p><span class="bolinha verde"></span> Unidades</p>
              <p><span class="bolinha verde"></span> Reservas</p>
              <p><span class="bolinha verde"></span> Ocorrências</p>
              <p><span class="bolinha verde"></span> Funcionários</p>
              <p><span class="bolinha verde"></span> Usuários</p>
            </div>
          </div>

          <div class="permissao-bloco">
            <div class="permissao-topo">
              <span class="permissao-cargo funcionario">Funcionário</span>
              <span>Acesso operacional</span>
            </div>

            <div class="permissoes-grid">
              <p><span class="bolinha verde"></span> Moradores</p>
              <p><span class="bolinha verde"></span> Unidades</p>
              <p><span class="bolinha verde"></span> Reservas</p>
              <p><span class="bolinha verde"></span> Ocorrências</p>
              <p><span class="bolinha vermelha"></span> Funcionários</p>
              <p><span class="bolinha vermelha"></span> Usuários</p>
            </div>
          </div>

          <div class="permissao-bloco">
            <div class="permissao-topo">
              <span class="permissao-cargo morador">Morador</span>
              <span>Acesso restrito</span>
            </div>

            <div class="permissoes-grid">
              <p><span class="bolinha vermelha"></span> Moradores</p>
              <p><span class="bolinha vermelha"></span> Unidades</p>
              <p><span class="bolinha verde"></span> Reservas</p>
              <p><span class="bolinha verde"></span> Ocorrências</p>
              <p><span class="bolinha vermelha"></span> Funcionários</p>
              <p><span class="bolinha vermelha"></span> Usuários</p>
            </div>
          </div>
        </div>

      </div>

    </section>

  </main>

</div>

<style>
  .perfil-container {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 28px;
    margin-top: 24px;
  }

  .perfil-card,
  .permissoes-card {
    background: #fff;
    border-radius: 10px;
    border: 1px solid #edf0f5;
    overflow: hidden;
  }

  .perfil-capa {
    height: 150px;
    background: #17284d;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .perfil-avatar-grande {
    width: 116px;
    height: 116px;
    background: #fff;
    color: #17284d;
    border-radius: 50%;
    margin-bottom: -58px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    font-weight: 700;
  }

  .perfil-corpo {
    padding: 76px 38px 28px;
    text-align: center;
  }

  .perfil-corpo h3 {
    font-size: 21px;
    color: #111827;
    margin-bottom: 14px;
  }

  .perfil-tipo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #eee9ff;
    color: #5b3fd6;
    padding: 10px 44px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
  }

  .perfil-dados {
    margin-top: 28px;
    text-align: left;
  }

  .perfil-linha {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    font-size: 14px;
  }

  .perfil-linha span {
    color: #64748b;
  }

  .perfil-linha strong {
    color: #111827;
    font-weight: 600;
  }

  .botao-sair {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    width: 100%;
    border: 1px solid #ef4444;
    background: #fee2e2;
    color: #dc2626;
    border-radius: 8px;
    padding: 14px;
    font-weight: 600;
    margin-top: 28px;
  }

  .botao-sair:hover {
    color: #dc2626;
    background: #fecaca;
  }

  .permissoes-card {
    padding: 28px;
  }

  .permissoes-card h3 {
    font-size: 16px;
    color: #17284d;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .permissao-bloco {
    background: #f8fafc;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 18px;
  }

  .permissao-admin {
    background: #f3efff;
    border: 1px solid #8b5cf6;
  }

  .permissao-topo {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
  }

  .permissao-cargo {
    min-width: 120px;
    text-align: center;
    background: #e9ddff;
    color: #6d28d9;
    padding: 9px 14px;
    border-radius: 6px;
    font-weight: 700;
  }

  .permissao-cargo.funcionario {
    background: #dbeafe;
    color: #2563eb;
  }

  .permissao-cargo.morador {
    background: #dcfce7;
    color: #16a34a;
  }

  .permissoes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px 28px;
  }

  .permissoes-grid p {
    margin: 0;
    color: #17284d;
    font-size: 13px;
    font-weight: 600;
  }

  .bolinha {
    width: 13px;
    height: 13px;
    display: inline-block;
    border-radius: 50%;
    margin-right: 8px;
  }

  .bolinha.verde {
    background: #10b981;
  }

  .bolinha.vermelha {
    border: 1px solid #ef4444;
    background: transparent;
  }

  @media (max-width: 992px) {
    .perfil-container {
      grid-template-columns: 1fr;
    }

    .permissoes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .permissoes-grid {
      grid-template-columns: 1fr;
    }

    .perfil-linha {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>

<%- include('../partials/footer') %>