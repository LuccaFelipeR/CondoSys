<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CondoSys — Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --dark-blue: #1c253c;
            --accent-purple: #8b5cf6;
            --input-bg: #f8fafc;
        }
        
        body, html { height: 100%; margin: 0; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        .login-wrapper { display: flex; height: 100vh; }
        
        /* --- Lado Esquerdo (Branding) --- */
        .login-left {
            flex: 1;
            background-color: var(--dark-blue);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px;
            position: relative;
            overflow: hidden;
        }
        /* Círculos decorativos do fundo */
        .circle-top { position: absolute; top: -100px; left: -50px; width: 400px; height: 400px; background: rgba(139, 92, 246, 0.15); border-radius: 50%; }
        .circle-bottom { position: absolute; bottom: -150px; right: 50px; width: 350px; height: 350px; background: rgba(139, 92, 246, 0.15); border-radius: 50%; }
        
        .brand-content { position: relative; z-index: 2; max-width: 400px; margin: 0 auto; }
        .brand-title { font-size: 3.5rem; font-weight: 700; margin-bottom: 0; }
        .brand-line { width: 150px; height: 4px; background-color: var(--accent-purple); margin: 15px 0 30px 0; border-radius: 2px; }
        .brand-subtitle { font-size: 1.1rem; color: #cbd5e1; margin-bottom: 40px; }
        
        .feature-list { list-style: none; padding: 0; }
        .feature-list li { margin-bottom: 16px; font-size: 0.95rem; display: flex; align-items: center; gap: 10px; color: #e2e8f0; }
        .feature-list i { color: #10b981; }

        /* --- Lado Direito (Formulário) --- */
        .login-right {
            flex: 1;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .form-container { width: 100%; max-width: 450px; padding: 40px; }
        .form-title { font-size: 1.8rem; font-weight: 600; color: var(--dark-blue); text-align: center; margin-bottom: 8px; }
        .form-subtitle { text-align: center; color: #64748b; font-size: 0.9rem; margin-bottom: 40px; }
        
        .custom-input { background-color: var(--input-bg); border: 1px solid transparent; padding: 14px; border-radius: 8px; font-size: 0.95rem; }
        .custom-input:focus { background-color: white; border-color: var(--accent-purple); box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1); }
        .form-label { font-size: 0.85rem; font-weight: 600; color: #334155; }
        
        .btn-login { background-color: var(--dark-blue); color: white; padding: 14px; border-radius: 8px; font-weight: 600; width: 100%; border: none; margin-top: 20px; transition: 0.2s; }
        .btn-login:hover { background-color: #121929; }
        
        .forgot-password { text-align: right; font-size: 0.8rem; margin-top: 8px; }
        .forgot-password a { color: #3b82f6; text-decoration: none; }
        
        .divider { display: flex; align-items: center; text-align: center; margin: 24px 0; color: #94a3b8; font-size: 0.85rem; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #e2e8f0; }
        .divider:not(:empty)::before { margin-right: 15px; }
        .divider:not(:empty)::after { margin-left: 15px; }
        
        .btn-institutional { background-color: white; color: #475569; border: 1px solid #e2e8f0; padding: 12px; border-radius: 8px; width: 100%; font-size: 0.9rem; font-weight: 500; }
    </style>
</head>
<body>

<div class="login-wrapper">
    <div class="login-left d-none d-lg-flex">
        <div class="circle-top"></div>
        <div class="circle-bottom"></div>
        
        <div class="brand-content">
            <h1 class="brand-title">CondoSys</h1>
            <div class="brand-line"></div>
            <p class="brand-subtitle">Gestão Condominial Inteligente</p>
            
            <ul class="feature-list">
                <li><i class="bi bi-check2"></i> Controle de moradores e unidades</li>
                <li><i class="bi bi-check2"></i> Gestão de reservas e ocorrências</li>
                <li><i class="bi bi-check2"></i> Painel administrativo completo</li>
                <li><i class="bi bi-check2"></i> Acesso por perfil de usuário</li>
            </ul>
        </div>
    </div>

    <div class="login-right">
        <div class="form-container">
            <h2 class="form-title">Bem-vindo de volta!</h2>
            <p class="form-subtitle">Acesse sua conta para continuar</p>

            <form action="/login" method="post">
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input type="email" name="email" class="form-control custom-input" placeholder="usuario@email.com" required>
                </div>
                
                <div class="mb-1">
                    <label class="form-label">Senha</label>
                    <input type="password" name="password" class="form-control custom-input" placeholder="••••••••" required>
                </div>
                
                <div class="forgot-password">
                    <a href="#">Esqueci minha senha</a>
                </div>

                <button type="submit" class="btn-login">Entrar</button>
            </form>

            <div class="divider">ou entre com</div>

            <button class="btn-institutional">
                <i class="bi bi-building me-2"></i> Entrar com conta institucional
            </button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>