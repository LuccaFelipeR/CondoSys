<%- include('../partials/header') %>

<div class="app-layout">

  <%- include('../partials/navbar', { paginaAtiva: 'moradores' }) %>

  <main class="main-content">

    <header class="topbar">
      <h1><%= titulo || 'Moradores' %></h1>

      <div class="topbar-actions">
        <input type="text" placeholder="Pesquisar..." disabled>

        <span class="notification-icon">
          <i class="bi bi-bell-fill"></i>
        </span>

        <div class="user-info">
          <div class="user-avatar">
            <%= usuario && usuario.nome ? usuario.nome.charAt(0).toUpperCase() : 'A' %>
          </div>

          <span>
            <%= usuario && usuario.nome ? usuario.nome : 'Administrador Geral' %>
          </span>
        </div>
      </div>
    </header>

    <section class="content-area">
      <h2>Moradores Cadastrados</h2>

      <div class="table-card">

        <div class="table-toolbar">
          <div class="search-group">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Buscar por nome, CPF ou unidade..." disabled>
          </div>

          <button class="filter-button" disabled>Filtros</button>

          <button 
            type="button" 
            class="primary-button" 
            data-bs-toggle="modal" 
            data-bs-target="#modalMorador"
          >
            <i class="bi bi-plus-lg"></i>
            Novo Morador
          </button>
        </div>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>Unidade</th>
                <th>Telefone</th>
                <th>E-mail</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>

            <tbody>
              <% if (moradores && moradores.length > 0) { %>

                <% moradores.forEach(morador => { %>
                  <tr>
                    <td><%= morador.nome %></td>
                    <td><%= morador.cpf %></td>
                    <td><%= morador.unidade_formatada %></td> 
                    <td><%= morador.telefone %></td>
                    <td><%= morador.email %></td>

                    <td>
                      <% if (morador.status === 'Ativo') { %>
                        <span class="badge badge-active">Ativo</span>
                      <% } else { %>
                        <span class="badge badge-inactive">Inativo</span>
                      <% } %>
                    </td>

                    <td>
                      <button
                        type="button"
                        class="edit-link border-0 bg-transparent p-0 btnEditarMorador"
                        data-bs-toggle="modal"
                        data-bs-target="#modalMorador"
                        data-id="<%= morador.id_morador %>"
                        data-nome="<%= morador.nome || '' %>"
                        data-cpf="<%= morador.cpf || '' %>"
                        data-id-unidade="<%= morador.id_unidade || '' %>"
                        data-telefone="<%= morador.telefone || '' %>"
                        data-email="<%= morador.email || '' %>"
                        data-data-nascimento="<%= morador.data_nascimento || morador.dataNascimento || '' %>"
                        data-modelo-veiculo="<%= morador.modeloVeiculo || morador.car_model || '' %>"
                        data-placa="<%= morador.placa_carro || morador.placa || '' %>"
                        data-cor="<%= morador.cor || '' %>"
                        data-vaga="<%= morador.vaga || '' %>"
                        data-observacoes="<%= morador.observacoes || '' %>"
                      >
                        <i class="bi bi-pencil-fill"></i>
                        Editar
                      </button>

                      <% if (morador.status === 'Ativo') { %>

                        <form
                          action="/moradores/<%= morador.id_morador %>/inativar"
                          method="POST"
                          style="display:inline;"
                        >
                          <button
                            type="submit"
                            class="edit-link border-0 bg-transparent p-0 ms-2 text-danger"
                            onclick="return confirm('Deseja realmente inativar este morador?')"
                          >
                            <i class="bi bi-trash-fill"></i>
                            Inativar
                          </button>
                        </form>

                      <% } else { %>

                        <form
                          action="/moradores/<%= morador.id_morador %>/reativar"
                          method="POST"
                          style="display:inline;"
                        >
                          <button
                            type="submit"
                            class="edit-link border-0 bg-transparent p-0 ms-2 text-success"
                            onclick="return confirm('Deseja realmente reativar este morador?')"
                          >
                            <i class="bi bi-arrow-clockwise"></i>
                            Reativar
                          </button>
                        </form>

                      <% } %>
                    </td>
                  </tr>
                <% }) %>

              <% } else { %>

                <tr>
                  <td colspan="7" class="empty-message">
                    Nenhum morador cadastrado.
                  </td>
                </tr>

              <% } %>
            </tbody>
          </table>
        </div>

        <div class="table-footer">
          <span>
            Exibindo <%= moradores ? moradores.length : 0 %> moradores
          </span>

          <div class="pagination">
            <button disabled>&laquo;</button>
            <button class="active-page">1</button>
            <button disabled>&raquo;</button>
          </div>
        </div>

      </div>
    </section>

  </main>

</div>

<div 
  class="modal fade" 
  id="modalMorador" 
  tabindex="-1" 
  aria-labelledby="modalMoradorLabel" 
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">

      <div class="modal-header border-bottom-0 pb-0 mt-3 ms-3">
        <h4 class="modal-title fw-bold" id="modalMoradorLabel">
          Cadastrar Morador
        </h4>

        <button 
          type="button"
          class="btn-close me-3" 
          data-bs-dismiss="modal" 
          aria-label="Fechar"
        ></button>
      </div>

      <div class="modal-body p-4">

        <form id="formMorador" action="/moradores/novo" method="POST">

          <h6 class="fw-bold mb-3">
            <i class="bi bi-person-fill text-primary me-2"></i>
            Dados Pessoais
          </h6>

          <div class="row g-3 mb-4">

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                Nome Completo <span class="text-danger">*</span>
              </label>

              <input 
                type="text" 
                name="nome"
                id="nome"
                class="form-control bg-light border-0" 
                placeholder="Ana Lima" 
                minlength="3"
                maxlength="100"
                pattern="[a-zA-ZÀ-ÿ\s]+" 
                title="O nome deve conter apenas letras e espaços."
                required
              >
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                CPF <span class="text-danger">*</span>
              </label>

              <input 
                type="text" 
                name="cpf"
                id="cpf"
                class="form-control bg-light border-0" 
                placeholder="123.456.789-00" 
                maxlength="14"
                pattern="\d{3}\.\d{3}\.\d{3}-\d{2}"
                title="Digite no formato 123.456.789-00"
                required
              >
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                Data de Nascimento
              </label>

              <input 
                type="date" 
                name="dataNascimento"
                id="dataNascimento"
                class="form-control bg-light border-0"
              >
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                E-mail <span class="text-danger">*</span>
              </label>

              <input 
                type="email" 
                name="email"
                id="email"
                class="form-control bg-light border-0" 
                placeholder="ana@email.com" 
                required
              >
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                Telefone
              </label>

              <input 
                type="text" 
                name="telefone"
                id="telefone"
                class="form-control bg-light border-0" 
                placeholder="(43) 9 9999-0001"
                maxlength="15"
                pattern="\(\d{2}\)\s\d{4,5}-\d{4}"
                oninput="mascaraTelefone(this)"
              >
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                Unidade Vinculada <span class="text-danger">*</span>
              </label>

              <select
                name="id_unidade"
                id="id_unidade"
                class="form-select bg-light border-0"
                required
              >
                <option value="">Selecione uma unidade</option>
                <% unidades.forEach(unidade => { %>
                  <option value="<%= unidade.id_unidade %>">
                    Bloco <%= unidade.bloco %> - Apto <%= unidade.numero %>
                  </option>
                <% }) %>
              </select>
            </div>

          </div>

          <h6 class="fw-bold mb-3">
            <i class="bi bi-car-front-fill text-danger me-2"></i>
            Veículo
          </h6>

          <div class="row g-3 mb-4">

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted">
                Modelo
              </label>

              <input 
                type="text" 
                name="modeloVeiculo"
                id="modeloVeiculo"
                class="form-control bg-light border-0" 
                placeholder="Toyota Corolla"
              >
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-semibold text-muted">
                Placa
              </label>

              <input 
                type="text" 
                name="placa"
                id="placa"
                class="form-control bg-light border-0" 
                placeholder="ABC-1D23"
                maxlength="8"
              >
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-semibold text-muted">
                Cor
              </label>

              <input 
                type="text" 
                name="cor"
                id="cor"
                class="form-control bg-light border-0" 
                placeholder="Prata"
              >
            </div>

            <div class="col-md-2">
              <label class="form-label small fw-semibold text-muted">
                Vaga nº
              </label>

              <input 
                type="text" 
                name="vaga"
                id="vaga"
                class="form-control bg-light border-0" 
                placeholder="12"
              >
            </div>

          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold text-muted">
              Observações
            </label>

            <textarea 
              name="observacoes"
              id="observacoes"
              class="form-control bg-light border-0" 
              rows="2" 
              placeholder="Morador com acesso à área comum até 22h..."
            ></textarea>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <button 
              type="button" 
              class="btn btn-outline-secondary px-4 py-2 rounded-3" 
              data-bs-dismiss="modal"
            >
              Cancelar
            </button>

            <div class="d-flex align-items-center gap-3">
              <span class="text-muted small">* Campos obrigatórios</span>

              <button 
                type="submit" 
                class="btn text-white px-4 py-2 rounded-3" 
                style="background-color: #172033; font-weight: 500;"
              >
                Salvar Morador
              </button>
            </div>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

<script>
// Captura a abertura do modal e preenche os campos automaticamente
document.getElementById('modalMorador').addEventListener('show.bs.modal', function (event) {
  const button = event.relatedTarget;
  
  // Extrai o ID do botão clicado
  const id = button.getAttribute('data-id');
  
  // Se não tem ID, é porque clicou em "Novo Morador", então não faz nada e deixa o modal vazio
  if (!id) return;

  // Atualiza a rota do formulário e o título
  document.getElementById('formMorador').action = '/moradores/' + id + '/editar';
  document.getElementById('modalMoradorLabel').innerText = 'Editar Morador';

  // Preenche todos os inputs puxando os dados do botão
  document.getElementById('nome').value = button.getAttribute('data-nome');
  document.getElementById('cpf').value = button.getAttribute('data-cpf');
  document.getElementById('email').value = button.getAttribute('data-email');
  document.getElementById('telefone').value = button.getAttribute('data-telefone');
  document.getElementById('id_unidade').value = button.getAttribute('data-id-unidade');
  
  // Preenchendo campos extras (caso estejam nulos no banco, eles ficam em branco graças ao || '' lá no botão)
  document.getElementById('dataNascimento').value = button.getAttribute('data-data-nascimento');
  document.getElementById('modeloVeiculo').value = button.getAttribute('data-modelo-veiculo');
  document.getElementById('placa').value = button.getAttribute('data-placa');
  document.getElementById('cor').value = button.getAttribute('data-cor');
  document.getElementById('vaga').value = button.getAttribute('data-vaga');
  document.getElementById('observacoes').value = button.getAttribute('data-observacoes');
});

// Reseta o formulário e a rota de volta para "Novo Morador" quando a janela fecha
document.getElementById('modalMorador').addEventListener('hidden.bs.modal', function() {
  document.getElementById('formMorador').reset();
  document.getElementById('formMorador').action = '/moradores/novo';
  document.getElementById('modalMoradorLabel').innerText = 'Cadastrar Morador';
});

// Máscara do Telefone
function mascaraTelefone(input) {
    let v = input.value.replace(/\D/g, "");
    if (v.length > 0) v = "(" + v;
    if (v.length > 3) v = v.substring(0, 3) + ") " + v.substring(3);
    
    if (v.length > 13) {
        v = v.substring(0, 10) + "-" + v.substring(10, 14);
    } else if (v.length > 9) {
        v = v.substring(0, 9) + "-" + v.substring(9);
    }
    
    input.value = v;
}
</script>

<%- include('../partials/footer') %>