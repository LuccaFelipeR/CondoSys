<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Funcionários - CondoSys</title>

  <link rel="stylesheet" href="/css/style.css">
  <link 
  rel="stylesheet" 
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>
</head>
<body>

  <div class="app-layout">

    <aside class="sidebar">
  <div>
    <div class="sidebar-logo">
      CondoSys
    </div>

    <nav class="sidebar-menu">
      <a href="/dashboard">
        <i class="bi bi-house-door"></i>
        <span>Home</span>
      </a>

      <a href="/moradores">
        <i class="bi bi-people"></i>
        <span>Moradores</span>
      </a>

      <a href="/unidades">
        <i class="bi bi-building"></i>
        <span>Unidades</span>
      </a>

      <a href="/reservas">
        <i class="bi bi-calendar-event"></i>
        <span>Reservas</span>
      </a>

      <a href="/ocorrencias">
        <i class="bi bi-exclamation-triangle"></i>
        <span>Ocorrências</span>
      </a>

      <a href="/funcionarios" class="active">
        <i class="bi bi-person-badge"></i>
        <span>Funcionários</span>
      </a>

      <a href="/usuarios">
        <i class="bi bi-person-gear"></i>
        <span>Usuários</span>
      </a>
    </nav>
  </div>

  <div class="sidebar-footer">
    <a href="/logout">
      <i class="bi bi-box-arrow-left"></i>
      <span>Sair</span>
    </a>
  </div>
</aside>

    <main class="main-content">

      <header class="topbar">
        <h1><%= titulo %></h1>

        <div class="topbar-actions">
          <input type="text" placeholder="Pesquisar..." disabled>
          <span class="notification">♧</span>

          <div class="user-area">
            <div class="avatar">A</div>
            <span>Admin</span>
          </div>
        </div>
      </header>

      <section class="content-area">
        <h2>Funcionários Cadastrados</h2>

        <div class="table-card">

          <div class="table-toolbar">
            <div class="search-group">
              <span>⌕</span>
              <input 
                type="text" 
                placeholder="Buscar por nome, CPF ou cargo..."
                disabled
              >
            </div>

            <button class="filter-button" disabled>Filtros</button>

            <a href="/funcionarios/novo" class="primary-button">
              + Novo Funcionário
            </a>
          </div>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>CPF</th>
                  <th>Cargo</th>
                  <th>Telefone</th>
                  <th>Data de Admissão</th>
                  <th>Status</th>
                  <th>Ações</th>
                </tr>
              </thead>

              <tbody>
                <% if (funcionarios.length === 0) { %>
                  <tr>
                    <td colspan="7" class="empty-message">
                      Nenhum funcionário cadastrado.
                    </td>
                  </tr>
                <% } %>

                <% funcionarios.forEach(funcionario => { %>
                  <tr>
                    <td><%= funcionario.nome %></td>
                    <td><%= funcionario.cpf %></td>
                    <td><%= funcionario.cargo %></td>
                    <td><%= funcionario.telefone %></td>
                    <td><%= funcionario.dataAdmissao %></td>
                    <td>
                      <% if (funcionario.status === 'Ativo') { %>
                        <span class="badge badge-active">Ativo</span>
                      <% } else { %>
                        <span class="badge badge-inactive">Inativo</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/funcionarios/<%= funcionario.id %>/editar" class="edit-link">
                        ✎ Editar
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>Exibindo 1-5 de <%= funcionarios.length %> funcionários</span>

            <div class="pagination">
              <button disabled>‹</button>
              <button class="active-page">1</button>
              <button disabled>2</button>
              <button disabled>3</button>
              <button disabled>›</button>
            </div>
          </div>

        </div>
      </section>

    </main>

  </div>

</body>
</html>